---
// 三合一搜索框组件：Bing / 百度 / Google
// iOS 风格滑动滑块切换（像苹果手机关机滑动那样丝滑）
const { compact = false } = Astro.props;
---

<div class:list={['tri-search', { 'tri-search-compact': compact }]}>
  <div class="tri-search-head">
    <span>🔎 <b>三合一搜索</b></span>
    <div class="search-tabs" role="tablist" data-search-tabs>
      <span class="search-thumb" data-search-thumb aria-hidden="true"></span>
      <button class="search-tab active" data-engine="bing" type="button">Bing</button>
      <button class="search-tab" data-engine="baidu" type="button">百度</button>
      <button class="search-tab" data-engine="google" type="button">Google</button>
    </div>
  </div>
  <form class="tools-search-form" id="global-search">
    <input
      class="search-box"
      type="search"
      id="global-search-input"
      placeholder="输入关键词，回车搜索…"
      autocomplete="off"
    />
    <button class="btn btn-primary" type="submit">搜索</button>
  </form>
</div>

<script>
  const ENGINE_URLS: Record<string, string> = {
    bing: 'https://www.bing.com/search?q=',
    baidu: 'https://www.baidu.com/s?wd=',
    google: 'https://www.google.com/search?q=',
  };
  const LABEL: Record<string, string> = { bing: 'Bing', baidu: '百度', google: 'Google' };
  const input = document.getElementById('global-search-input') as HTMLInputElement;
  const tabs = document.querySelectorAll('.search-tab');
  const form = document.getElementById('global-search') as HTMLFormElement;
  const thumb = document.querySelector('[data-search-thumb]') as HTMLElement | null;
  const tabsWrap = document.querySelector('[data-search-tabs]') as HTMLElement | null;
  let engine = 'bing';

  // 移动滑块到指定 tab
  function moveThumb(tab: HTMLElement) {
    if (!thumb || !tabsWrap) return;
    const tabRect = tab.getBoundingClientRect();
    const wrapRect = tabsWrap.getBoundingClientRect();
    const left = tabRect.left - wrapRect.left;
    thumb.style.width = `${tabRect.width}px`;
    thumb.style.transform = `translateX(${left}px)`;
  }

  // 初始化滑块位置
  function initThumb() {
    const active = document.querySelector('.search-tab.active') as HTMLElement | null;
    if (active) {
      // 先无动画定位，再启用过渡
      if (thumb) thumb.style.transition = 'none';
      moveThumb(active);
      requestAnimationFrame(() => {
        if (thumb) thumb.style.transition = '';
      });
    }
  }

  tabs.forEach((t) => {
    const tab = t as HTMLElement;
    tab.addEventListener('click', () => {
      engine = tab.dataset.engine!;
      tabs.forEach((x) => x.classList.remove('active'));
      tab.classList.add('active');
      moveThumb(tab);
      input.placeholder = `用 ${LABEL[engine]} 搜索…`;
    });
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q) return;
    window.open(ENGINE_URLS[engine] + encodeURIComponent(q), '_blank');
  });

  // 窗口尺寸变化/字体加载后重新定位
  window.addEventListener('resize', initThumb);
  if (document.fonts) {
    document.fonts.ready.then(initThumb);
  }
  initThumb();
</script>

<style>
  .tri-search {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 24px;
    margin: 24px 0 32px;
  }
  .tri-search-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .tri-search-head > span {
    font-size: 1.05rem;
    color: var(--fg);
  }
  .tri-search-compact { margin: 8px 0 28px; padding: 18px; }
  .tri-search-compact .tri-search-head { margin-bottom: 12px; }
  .tools-search-form {
    display: flex;
    gap: 10px;
  }
  .tools-search-form .search-box { flex: 1; }

  /* iOS 风格滑动滑块 */
  .search-tabs {
    position: relative;
    display: inline-flex;
    gap: 4px;
    background: var(--bg-soft);
    padding: 4px;
    border-radius: 999px;
    border: 1px solid var(--border);
  }
  .search-thumb {
    position: absolute;
    top: 4px;
    left: 4px;
    height: calc(100% - 8px);
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 2px 8px hsl(var(--hue) 70% 50% / 0.35);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
    z-index: 0;
  }
  .search-tab {
    position: relative;
    z-index: 1;
    border: none;
    background: transparent;
    padding: 6px 16px;
    border-radius: 999px;
    cursor: pointer;
    color: var(--fg-muted);
    font-weight: 600;
    font-size: 0.88rem;
    transition: color 0.3s var(--ease);
    white-space: nowrap;
  }
  .search-tab.active {
    color: #fff;
  }
</style>
