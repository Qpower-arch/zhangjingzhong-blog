---
// 三合一搜索框组件：Bing / 百度 / Google
// iOS 风格滑动滑块切换（像苹果手机关机滑动那样丝滑）
const { compact = false } = Astro.props;
---

<div class:list={['tri-search', { 'tri-search-compact': compact }]}>
  <div class="tri-search-head">
    <span>🔎 <b>三合一搜索</b></span>
    <div class="search-tabs" role="tablist" data-search-tabs>
      <span class="search-thumb" data-search-thumb aria-hidden="true"></span>
      <button class="search-tab active" data-engine="bing" type="button">Bing</button>
      <button class="search-tab" data-engine="baidu" type="button">百度</button>
      <button class="search-tab" data-engine="google" type="button">Google</button>
    </div>
  </div>
  <form class="tools-search-form" data-search-form>
    <input
      class="search-box"
      type="search"
      data-search-input
      placeholder="输入关键词，回车搜索…"
      autocomplete="off"
    />
    <button class="btn btn-primary" type="submit">搜索</button>
  </form>
</div>

<script>
  const ENGINE_URLS: Record<string, string> = {
    bing: 'https://www.bing.com/search?q=',
    baidu: 'https://www.baidu.com/s?wd=',
    google: 'https://www.google.com/search?q=',
  };
  const LABEL: Record<string, string> = { bing: 'Bing', baidu: '百度', google: 'Google' };
  let engine = 'bing';

  // 重新初始化滑块位置（导航到新页面时调用）
  function syncThumb() {
    const wrap = document.querySelector('[data-search-tabs]') as HTMLElement | null;
    const thumb = document.querySelector('[data-search-thumb]') as HTMLElement | null;
    const active = document.querySelector('.search-tab.active') as HTMLElement | null;
    if (!wrap || !thumb || !active) return;
    const tabRect = active.getBoundingClientRect();
    const wrapRect = wrap.getBoundingClientRect();
    // 无动画定位
    thumb.style.transition = 'none';
    thumb.style.width = `${tabRect.width}px`;
    thumb.style.transform = `translateX(${tabRect.left - wrapRect.left}px)`;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        thumb.style.transition = '';
      });
    });
  }

  function moveThumbTo(tab: HTMLElement) {
    const wrap = document.querySelector('[data-search-tabs]') as HTMLElement | null;
    const thumb = document.querySelector('[data-search-thumb]') as HTMLElement | null;
    if (!wrap || !thumb) return;
    const tabRect = tab.getBoundingClientRect();
    const wrapRect = wrap.getBoundingClientRect();
    thumb.style.width = `${tabRect.width}px`;
    thumb.style.transform = `translateX(${tabRect.left - wrapRect.left}px)`;
  }

  // 事件委托：切换引擎（绑定在 document，跨页面软导航仍有效）
  document.addEventListener('click', (e) => {
    const tab = (e.target as HTMLElement).closest('.search-tab') as HTMLElement | null;
    if (!tab) return;
    const wrap = tab.closest('[data-search-tabs]');
    if (!wrap) return;
    engine = tab.dataset.engine || 'bing';
    wrap.querySelectorAll('.search-tab').forEach((x) => x.classList.remove('active'));
    tab.classList.add('active');
    moveThumbTo(tab);
    const input = document.querySelector('[data-search-input]') as HTMLInputElement | null;
    if (input) input.placeholder = `用 ${LABEL[engine]} 搜索…`;
  });

  // 事件委托：提交搜索
  document.addEventListener('submit', (e) => {
    const form = (e.target as HTMLElement).closest('[data-search-form]');
    if (!form) return;
    e.preventDefault();
    const input = form.querySelector('[data-search-input]') as HTMLInputElement | null;
    const q = input?.value.trim();
    if (!q) return;
    window.open(ENGINE_URLS[engine] + encodeURIComponent(q), '_blank');
  });

  // 初始化 + 页面切换后重新同步
  function init() {
    syncThumb();
  }
  init();
  // View Transitions 软导航后重新同步滑块位置
  document.addEventListener('astro:page-load', init);
  window.addEventListener('resize', init);
  if (document.fonts) {
    document.fonts.ready.then(init);
  }
</script>

<style>
  .tri-search {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 24px;
    margin: 24px 0 32px;
  }
  .tri-search-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .tri-search-head > span {
    font-size: 1.05rem;
    color: var(--fg);
  }
  .tri-search-compact { margin: 8px 0 28px; padding: 18px; }
  .tri-search-compact .tri-search-head { margin-bottom: 12px; }
  .tools-search-form {
    display: flex;
    gap: 10px;
  }
  .tools-search-form .search-box { flex: 1; }

  /* iOS 风格滑动滑块 */
  .search-tabs {
    position: relative;
    display: inline-flex;
    gap: 4px;
    background: var(--bg-soft);
    padding: 4px;
    border-radius: 999px;
    border: 1px solid var(--border);
  }
  .search-thumb {
    position: absolute;
    top: 4px;
    left: 4px;
    height: calc(100% - 8px);
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 2px 8px hsl(var(--hue) 70% 50% / 0.35);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
    z-index: 0;
  }
  .search-tab {
    position: relative;
    z-index: 1;
    border: none;
    background: transparent;
    padding: 6px 16px;
    border-radius: 999px;
    cursor: pointer;
    color: var(--fg-muted);
    font-weight: 600;
    font-size: 0.88rem;
    transition: color 0.3s var(--ease);
    white-space: nowrap;
  }
  .search-tab.active {
    color: #fff;
  }
</style>
