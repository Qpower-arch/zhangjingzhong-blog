---
import { commentConfig } from '../site.config';
import { withBase } from '../lib/base';

interface Props {
  slug: string;
  title: string;
}
const { slug, title } = Astro.props;

// 判断当前启用哪种评论
const useWaline =
  commentConfig.provider === 'waline' && commentConfig.walineServer !== '';
const useArtalk =
  commentConfig.provider === 'artalk' && commentConfig.artalkServer !== '';
const useGiscus =
  commentConfig.provider === 'giscus' &&
  commentConfig.repo !== '' &&
  commentConfig.repoId !== '' &&
  commentConfig.categoryId !== '';
const anyEnabled = useWaline || useArtalk || useGiscus;
---

<section class="comments" data-comments-section data-slug={slug}>
  <h2 style="margin-top: 2em;">💬 评论</h2>

  {
    !anyEnabled && (
      <div class="card muted" style="font-size:.9rem">
        <p style="margin:0 0 6px">
          📌 评论功能尚未启用。当前为占位提示。
        </p>
        <p style="margin:0">
          将评论服务地址填入 <code>src/site.config.ts</code> 的
          <code>commentConfig.walineServer</code>，重新部署即可生效。
        </p>
      </div>
    )
  }

  <!-- Waline 挂载点 -->
  {useWaline && <div class="card" id="waline-container"></div>}

  <!-- Artalk 挂载点（备选） -->
  {useArtalk && <div class="card" id="artalk-comments"></div>}

  <!-- Giscus 挂载点（备选） -->
  {useGiscus && <div class="card" data-giscus-container></div>}
</section>

{
  useWaline && (
    <script define:vars={{ walineServer: commentConfig.walineServer, pageKey: slug, homeUrl: withBase('/') }}>
      // ===== Waline 前端资源 CDN 列表 =====
      // 按顺序尝试：国内 unpkg 经常不可达，所以优先用 jsDelivr，再兜底 npmmirror
      var WALINE_VER = '3.5.7';
      var WALINE_CDNS = [
        'https://cdn.jsdelivr.net/npm/@waline/client@' + WALINE_VER + '/dist/',
        'https://registry.npmmirror.com/@waline/client/' + WALINE_VER + '/files/dist/',
        'https://unpkg.com/@waline/client@' + WALINE_VER + '/dist/'
      ];

      // Waline 加载：用 CDN 引入前端组件
      function initWaline() {
        const container = document.getElementById('waline-container');
        if (!container || window.__walineInited) return;
        window.__walineInited = true;

        // 加载 Waline CSS
        if (!document.getElementById('waline-css')) {
          const css = document.createElement('link');
          css.id = 'waline-css';
          css.rel = 'stylesheet';
          css.href = WALINE_CDNS[0] + 'waline.css';
          document.head.appendChild(css);
        }

        // 加载 Waline JS：★ 必须用 UMD 版本（waline.umd.js），
        //   因为 dist/waline.js 是 ES Module，直接用 <script> 加载不会挂载 window.Waline
        (function loadWalineScript() {
          var idx = 0;
          function tryNext() {
            if (idx >= WALINE_CDNS.length) {
              console.warn('[Waline] 所有 CDN 均加载失败，评论功能不可用');
              return;
            }
            var s = document.createElement('script');
            s.src = WALINE_CDNS[idx] + 'waline.umd.js';
            s.async = true;
            s.onload = function () {
              // 只有真正挂载了 Waline.init 才算成功，否则换下一个 CDN
              if (window.Waline && window.Waline.init) {
                mountWaline();
              } else {
                idx++;
                tryNext();
              }
            };
            s.onerror = function () {
              idx++;
              tryNext();
            };
            document.body.appendChild(s);
          }
          tryNext();
        })();

        function mountWaline() {
          // ===== 头像策略：QQ 邮箱自动使用 QQ 头像，其他用国内可访问的头像服务 =====
          function resolveAvatar(comment) {
            const mail = (comment && comment.mail) || '';
            // 纯数字 QQ 邮箱 → QQ 官方头像
            const m = /^(\d{5,11})@qq\.com$/i.exec(mail.trim());
            if (m) {
              return 'https://q1.qlogo.cn/g?b=qq&nk=' + m[1] + '&s=100';
            }
            // 其他邮箱 → Cravatar（Gravatar 国内镜像）；没有邮箱则用首字母头像
            if (!mail) {
              const seed = encodeURIComponent((comment && comment.nick) || 'user');
              return 'https://api.dicebear.com/7.x/initials/svg?seed=' + seed;
            }
            return 'https://cravatar.cn/avatar/';
          }

          // ★ Waline v3 的 API 是 Waline.init()，不是 new Waline()
          window.Waline.init({
            el: '#waline-container',
            serverURL: walineServer,
            path: pageKey,
            meta: ['nick', 'mail', 'link'],
            requiredMeta: ['nick'],
            login: 'enable', // 邮箱注册/登录后可评论
            dark: 'auto',
            imageUploader: false,
            pageview: false,
            avatar: resolveAvatar,
            search: false,
          });

          // ===== 注册/登录成功后切换到网站首页 =====
          // 判断依据：Waline v3 把登录用户存在 localStorage 的 WALINE_USER 里
          //   · 未登录 → "{}"（空对象）
          //   · 已登录 → 含 token / nick 等信息的对象
          let jumped = false;
          function isLoggedIn() {
            try {
              const raw = localStorage.getItem('WALINE_USER');
              if (!raw) return false;
              const u = JSON.parse(raw);
              if (!u || typeof u !== 'object') return false;
              return !!(u.token || u.nick || u.email || Object.keys(u).length > 0);
            } catch (e) {
              return false;
            }
          }

          const wasLoggedIn = isLoggedIn();
          const timer = window.setInterval(() => {
            if (jumped) return;
            if (isLoggedIn() && !wasLoggedIn) {
              jumped = true;
              window.clearInterval(timer);
              // 注册 / 登录成功 → 切换到网站首页
              window.location.href = homeUrl;
            }
          }, 700);
        }
      }

      // 等文档就绪后初始化
      if (document.readyState === 'complete') initWaline();
      else window.addEventListener('load', initWaline);
    </script>
  )
}

{
  useArtalk && (
    <script is:inline>
      // Artalk 前端加载（备选方案）
      const artalkServer = '{commentConfig.artalkServer}';
      const artalkSite = '{commentConfig.artalkSite}';
      const pageKey = '{slug}';
      const pageTitle = '{title}';

      function loadArtalk() {
        const container = document.getElementById('artalk-comments');
        if (!container) return;
        if (!document.getElementById('artalk-css')) {
          const css = document.createElement('link');
          css.id = 'artalk-css';
          css.rel = 'stylesheet';
          css.href = 'https://unpkg.com/artalk@2/dist/Artalk.css';
          document.head.appendChild(css);
        }
        if (window.Artalk) {
          initArtalk();
        } else {
          const s = document.createElement('script');
          s.src = 'https://unpkg.com/artalk@2/dist/Artalk.js';
          s.async = true;
          s.onload = initArtalk;
          document.body.appendChild(s);
        }
      }

      function initArtalk() {
        if (window.__artalkInited) return;
        if (!window.Artalk) return;
        window.__artalkInited = true;
        const artalk = new window.Artalk({
          el: '#artalk-comments',
          pageKey: pageKey,
          pageTitle: pageTitle,
          server: artalkServer,
          site: artalkSite,
          darkMode: document.documentElement.getAttribute('data-theme') === 'dark',
        });
        const mo = new MutationObserver(() => {
          const dark = document.documentElement.getAttribute('data-theme') === 'dark';
          if (artalk) artalk.setDarkMode(dark);
        });
        mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      }

      window.addEventListener('load', loadArtalk);
      if (document.readyState === 'complete') loadArtalk();
    </script>
  )
}

{
  useGiscus && (
    <script is:inline>
      // giscus 加载配置（备选方案）
      const giscusConfig = {
        repo: '{commentConfig.repo}',
        repoId: '{commentConfig.repoId}',
        category: '{commentConfig.category}',
        categoryId: '{commentConfig.categoryId}',
        mapping: '{commentConfig.mapping}',
        lang: '{commentConfig.lang}',
      };
      window.addEventListener('load', () => {
        const container = document.querySelector('[data-giscus-container]');
        if (!container) return;
        const s = document.createElement('script');
        s.src = 'https://giscus.app/client.js';
        s.async = true;
        s.crossOrigin = 'anonymous';
        s.setAttribute('data-repo', giscusConfig.repo);
        s.setAttribute('data-repo-id', giscusConfig.repoId);
        s.setAttribute('data-category', giscusConfig.category);
        s.setAttribute('data-category-id', giscusConfig.categoryId);
        s.setAttribute('data-mapping', giscusConfig.mapping);
        s.setAttribute('data-strict', '0');
        s.setAttribute('data-reactions-enabled', '1');
        s.setAttribute('data-emit-metadata', '0');
        s.setAttribute('data-input-position', 'top');
        s.setAttribute('data-theme', 'preferred_color_scheme');
        s.setAttribute('data-lang', giscusConfig.lang);
        s.setAttribute('data-loading', 'lazy');
        container.appendChild(s);
      });
    </script>
  )
}
