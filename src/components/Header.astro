---
import { siteConfig } from '../site.config';
import { withBase } from '../lib/base';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const links = [
  { href: '/blog', label: '文章' },
  { href: '/progress', label: '学习进度' },
  { href: '/resources', label: '软件资源' },
  { href: '/search', label: '搜索' },
];

function isActive(href: string, path: string): boolean {
  return path.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href={withBase('/')} class="logo">
      <span class="logo-icon">{siteConfig.shortName[0]}</span>
      <span>{siteConfig.shortName}</span>
    </a>
    <nav class="nav">
      {
        links.map((l) => (
          <a
            href={withBase(l.href)}
            class:list={[{ active: isActive(l.href, currentPath) }]}
          >
            {l.label}
          </a>
        ))
      }
      <button class="icon-btn" data-theme-toggle title="切换深浅色" type="button">
        🌓
      </button>
    </nav>
  </div>
</header>
