---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
---

<BaseLayout title="页面不存在">
  <div class="center" style="padding:80px 0;">
    <h1 style="font-size:4rem; margin:0;">404</h1>
    <p class="muted" style="font-size:1.1rem;">页面不存在或已被移动</p>
    <p style="margin-top:24px;">
      <a class="btn btn-primary" href={withBase('/')}>🏠 回到首页</a>
    </p>
  </div>
</BaseLayout>
