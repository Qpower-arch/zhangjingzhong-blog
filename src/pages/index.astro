---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/dates';
import { withBase } from '../lib/base';
import { siteConfig } from '../site.config';
import TriSearch from '../components/TriSearch.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const progress = (await getCollection('progress'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const featuredResources = (await getCollection('resources'))
  .filter((r) => r.data.featured)
  .slice(0, 4);
---

<BaseLayout wide>
  <section class="hero">
    <h1><span class="grad">{siteConfig.author}</span> 的博客</h1>
    <p class="hero-greet">
      {siteConfig.description}
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={withBase('/blog')}>阅读文章</a>
      <a class="btn" href={withBase('/tools')}>工具箱</a>
      <a class="btn" href={withBase('/progress')}>学习进度</a>
    </div>
  </section>

  <TriSearch compact />

  <!-- 网站功能快捷入口：让用户一眼直达各板块 -->
  <div class="quick-nav" style="margin-top:16px;">
    <a class="quick-card" href={withBase('/blog')}>
      <span class="quick-icon">📖</span>
      <span class="quick-title">文章</span>
      <span class="quick-desc">全部文章与教程</span>
    </a>
    <a class="quick-card" href={withBase('/tools')}>
      <span class="quick-icon">🧰</span>
      <span class="quick-title">学习工具</span>
      <span class="quick-desc">电脑测试工具箱</span>
    </a>
    <a class="quick-card" href={withBase('/resources')}>
      <span class="quick-icon">📦</span>
      <span class="quick-title">软件资源</span>
      <span class="quick-desc">好用的软件整理</span>
    </a>
    <a class="quick-card" href={withBase('/search')}>
      <span class="quick-icon">🔍</span>
      <span class="quick-title">搜索</span>
      <span class="quick-desc">站内全文搜索</span>
    </a>
  </div>

  <h2 class="section-title">
    <span>最新文章</span>
    <a class="muted" style="font-size:.9rem; font-weight:400" href={withBase('/blog')}>查看全部 →</a>
  </h2>
  <div class="post-grid">
    {
      posts.map((post) => (
        <article class="post-card">
          <a class="post-card-link" href={withBase(`/blog/${post.id}/`)}>
            <div class="post-card-meta">
              <span class="tag tag-accent">{post.data.category}</span>
              <time class="muted mono" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
            </div>
            <h3>{post.data.title}</h3>
            <p class="post-excerpt">{post.data.description}</p>
          </a>
        </article>
      ))
    }
  </div>

  <h2 class="section-title">
    <span>学习进度</span>
    <a class="muted" style="font-size:.9rem; font-weight:400" href={withBase('/progress')}>完整时间线 →</a>
  </h2>
  <div class="timeline">
    {
      progress.map((item) => (
        <div class:list={['tl-item', item.data.status === '已完成' && 'done', item.data.status === '计划中' && 'planned', item.data.status === '暂停' && 'paused']}>
          <div class="tl-date">{formatDate(item.data.date)}</div>
          <div class="tl-title">
            {item.data.title}
            <span class:list={['badge', item.data.status === '已完成' && 'badge-done', item.data.status === '进行中' && 'badge-doing', item.data.status === '计划中' && 'badge-planned', item.data.status === '暂停' && 'badge-paused']}>
              {item.data.status}
            </span>
          </div>
        </div>
      ))
    }
  </div>

  <h2 class="section-title">
    <span>精选资源</span>
    <a class="muted" style="font-size:.9rem; font-weight:400" href={withBase('/resources')}>全部资源 →</a>
  </h2>
  <div class="post-list">
    {
      featuredResources.map((r) => (
        <div class="post-item resource-card">
          <div class="resource-head">
            <h3><a href={r.data.url} target="_blank" rel="noopener noreferrer">{r.data.name}</a></h3>
            <span class="tag tag-accent">{r.data.category}</span>
          </div>
          <p class="resource-desc">{r.data.description}</p>
        </div>
      ))
    }
  </div>
</BaseLayout>
