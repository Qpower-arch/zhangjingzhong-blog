---
import '../styles/global.css';
import { siteConfig } from '../site.config';
import { withBase } from '../lib/base';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  // 文章页正文内容宽一点
  wide?: boolean;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  wide = false,
} = Astro.props;

const pageTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
// canonical 需要完整含 base 的绝对 URL，直接用配置的 site + 当前路径
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321');
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang={siteConfig.lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.name}
      href={withBase('/rss.xml')}
    />
    <!-- 主题初始化：避免刷新闪白 -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t)
            t = window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <style is:global>
      .hero-greet {
        font-size: 1.15rem;
      }
    </style>
  </head>
  <body>
    <!-- 顶部滚动进度条 -->
    <div class="scroll-progress" data-scroll-progress></div>
    <Header currentPath={Astro.url.pathname} />
    <main class:list={['main', 'container', { wide }]}>
      <slot />
    </main>
    <Footer />
    <script>
      // 暗色模式切换（Header 按钮触发）
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('[data-theme-toggle]');
        if (!btn) return;
        const html = document.documentElement;
        const next =
          html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (err) {}
      });

      // 顶部滚动进度条
      const progressBar = document.querySelector('[data-scroll-progress]');
      if (progressBar) {
        const updateProgress = () => {
          const h = document.documentElement;
          const scrolled = h.scrollTop / (h.scrollHeight - h.clientHeight);
          (progressBar as HTMLElement).style.transform = `scaleX(${scrolled})`;
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      }

      // 滚动渐入动画（IntersectionObserver）
      const revealEls = document.querySelectorAll(
        '.post-card, .post-item, .quick-card, .tl-item, .card, .resource-card'
      );
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => el.classList.add('reveal'));
        revealEls.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
