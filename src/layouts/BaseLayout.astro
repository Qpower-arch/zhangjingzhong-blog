---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import { siteConfig } from '../site.config';
import { withBase } from '../lib/base';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  // 文章页正文内容宽一点
  wide?: boolean;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  wide = false,
} = Astro.props;

const pageTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
// canonical 需要完整含 base 的绝对 URL，直接用配置的 site + 当前路径
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321');
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang={siteConfig.lang} data-theme="light" data-base={withBase('/')}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- ========== PWA（可"添加到主屏幕"，像 App 一样用）========== -->
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <meta name="theme-color" content="#7c3aed" />
    <!-- Service Worker 的准确地址（由 withBase 生成，避免手拼路径出错） -->
    <meta name="pwa-sw" content={withBase('/sw.js')} />
    <!-- iOS 专用：加到主屏后全屏运行 -->
    <link rel="apple-touch-icon" href={withBase('/icon-192.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.shortName} />

    <!-- App 模式检测 -->
    <script is:inline>
      // ============ App 模式检测 ============
      // 命中任一种即给 html 加 .app-mode（用于隐藏「工具箱」并适配刘海屏）：
      //   1) PWA：从主屏幕图标启动（独立窗口模式）
      //   2) Capacitor 打包的原生 App：注入了 window.Capacitor
      (function detectAppMode() {
        var html = document.documentElement;
        function mark() {
          html.classList.add('app-mode');
        }
        try {
          // —— PWA 独立窗口，可立即判断 ——
          if (
            (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) ||
            (window.matchMedia && window.matchMedia('(display-mode: fullscreen)').matches) ||
            (window.matchMedia && window.matchMedia('(display-mode: minimal-ui)').matches) ||
            window.navigator.standalone === true
          ) {
            mark();
            return;
          }
          // —— Capacitor 原生 App：桥接脚本可能晚于本脚本注入，短轮询检测 ——
          var tries = 0;
          var timer = setInterval(function () {
            if (typeof window.Capacitor !== 'undefined') {
              mark();
              clearInterval(timer);
            } else if (++tries > 40) {
              // 约 4 秒后放弃（说明是普通浏览器访问）
              clearInterval(timer);
            }
          }, 100);
        } catch (e) {}
      })();
    </script>

    <ViewTransitions />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.name}
      href={withBase('/rss.xml')}
    />
    <!-- 主题初始化：避免刷新闪白 -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t)
            t = window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <style is:global>
      .hero-greet {
        font-size: 1.15rem;
      }
    </style>
  </head>
  <body>
    <!-- 顶部滚动进度条 -->
    <div class="scroll-progress" data-scroll-progress></div>
    <!-- 多彩渐变光斑背景 -->
    <div class="aurora-bg" aria-hidden="true">
      <div class="aurora aurora-1"></div>
      <div class="aurora aurora-2"></div>
      <div class="aurora aurora-3"></div>
    </div>
    <!-- 自定义发光光标 -->
    <div class="cursor-dot" data-cursor-dot aria-hidden="true"></div>
    <div class="cursor-ring" data-cursor-ring aria-hidden="true"></div>
    <Header currentPath={Astro.url.pathname} />
    <main class:list={['main', 'container', { wide }]}>
      <slot />
    </main>
    <Footer />
    <script>
      // ============ 注册 Service Worker（PWA：可安装 + 离线访问） ============
      if ('serviceWorker' in navigator) {
        const registerSW = () => {
          // 从 meta 读取由 withBase() 生成的准确地址（避免手拼路径出错）
          const meta = document.querySelector('meta[name="pwa-sw"]');
          const swUrl = meta ? meta.getAttribute('content') : null;
          if (!swUrl) return;
          // scope 取 sw.js 所在目录（必须以 / 结尾）
          const scope = swUrl.replace(/sw\.js$/, '');
          navigator.serviceWorker
            .register(swUrl, { scope })
            .catch((err) => {
              console.warn('[PWA] Service Worker 注册失败：', err);
            });
        };
        // load 可能已经触发过，两种情况都要覆盖
        if (document.readyState === 'complete') registerSW();
        else window.addEventListener('load', registerSW);
      }

      // 暗色模式切换（Header 按钮触发）
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('[data-theme-toggle]');
        if (!btn) return;
        const html = document.documentElement;
        const next =
          html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (err) {}
      });

      // 顶部滚动进度条
      const progressBar = document.querySelector('[data-scroll-progress]');
      if (progressBar) {
        const updateProgress = () => {
          const h = document.documentElement;
          const scrolled = h.scrollTop / (h.scrollHeight - h.clientHeight);
          (progressBar as HTMLElement).style.transform = `scaleX(${scrolled})`;
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      }

      // 滚动渐入动画（IntersectionObserver）
      const revealEls = document.querySelectorAll(
        '.post-card, .post-item, .quick-card, .tl-item, .card, .resource-card'
      );

      // ★ 隐藏态（.reveal）只在 JS 正常运行时才添加：
      //   万一脚本失效，内容不会"隐形"
      revealEls.forEach((el) => el.classList.add('reveal'));

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // ★ 兜底方案：万一 IntersectionObserver 因任何原因没触发，
      //   改为按元素位置手动判断并显示，保证内容永远不会"隐形"
      const fallbackReveal = () => {
        document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < window.innerHeight - 40 && r.bottom > 0) {
            el.classList.add('is-visible');
          }
        });
      };
      fallbackReveal(); // 首屏立即检查一次
      window.addEventListener('scroll', fallbackReveal, { passive: true });
      window.addEventListener('resize', fallbackReveal, { passive: true });

      // ============ 自定义发光光标（桌面端） ============
      const dot = document.querySelector('[data-cursor-dot]') as HTMLElement | null;
      const ring = document.querySelector('[data-cursor-ring]') as HTMLElement | null;
      const isFinePointer = window.matchMedia('(pointer: fine)').matches;
      if (dot && ring && isFinePointer) {
        document.documentElement.classList.add('has-custom-cursor');
        let mx = 0, my = 0, rx = 0, ry = 0;
        window.addEventListener('mousemove', (e) => {
          mx = e.clientX; my = e.clientY;
          dot.style.transform = `translate(${mx}px, ${my}px)`;
        });
        const loop = () => {
          rx += (mx - rx) * 0.18;
          ry += (my - ry) * 0.18;
          ring.style.transform = `translate(${rx}px, ${ry}px)`;
          requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);
        // 悬浮可交互元素时放大光环
        document.querySelectorAll('a, button, .post-card, .quick-card').forEach((el) => {
          el.addEventListener('mouseenter', () => ring.classList.add('cursor-active'));
          el.addEventListener('mouseleave', () => ring.classList.remove('cursor-active'));
        });
      }

      // ============ 卡片 3D 倾斜 ============
      document.querySelectorAll('.post-card, .quick-card').forEach((card) => {
        const el = card as HTMLElement;
        if (!isFinePointer) return;
        el.addEventListener('mousemove', (e) => {
          const rect = el.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;
          el.style.transform = `perspective(900px) rotateX(${(-y * 6).toFixed(2)}deg) rotateY(${(x * 6).toFixed(2)}deg) translateY(-3px)`;
        });
        el.addEventListener('mouseleave', () => {
          el.style.transform = '';
        });
      });

      // ============ 光斑背景随滚动轻微视差 ============
      const auroras = document.querySelectorAll('.aurora');
      if (auroras.length) {
        window.addEventListener('scroll', () => {
          const y = window.scrollY;
          (auroras[0] as HTMLElement).style.transform = `translateY(${y * 0.15}px)`;
          (auroras[1] as HTMLElement).style.transform = `translateY(${y * 0.08}px)`;
        }, { passive: true });
      }
    </script>
  </body>
</html>
